{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "imrdy hook || \"${CLAUDE_PLUGIN_ROOT}/install-bootstrap.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
